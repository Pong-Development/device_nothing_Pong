# Bluetooth
persist.bluetooth.bqr.event_mask=0x8000000E
persist.bluetooth.bqr.min_interval_ms=6000

# Camera
vendor.camera.aux.packagelist=org.lineageos.aperture,com.instagram.android,com.snapchat.android

# Display
debug.sf.enable_hwc_vds=0
sys.brightness.disable_gamma_conversion=true
persist.sys.sf.native_mode=260

# Netmgr
persist.data.df.agg.dl_pkt=10
persist.data.df.agg.dl_size=4096
persist.vendor.data.mode=concurrent

# Nothing Feature
ro.build.nothing.feature.base=0xe24800001004458438124a040106b4247b97ffL
ro.build.nothing.feature.diff.device.Pong=0x24100003044002001aa4144ac04803d1842000L
