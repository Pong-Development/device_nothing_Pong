# Charging control
/vendor/bin/nt-charging-control					u:object_r:nt_chg_exec:s0

# Fingerprint
/dev/goodix_fp												u:object_r:fingerprint_device:s0
/mnt/vendor/persist/goodix(/.*)?									u:object_r:vendor_persist_goodix_file:s0
/vendor/bin/hw/android\.hardware\.biometrics\.fingerprint-service\.nothing				u:object_r:hal_fingerprint_default_exec:s0

# Process and system statistics files
/proc/stat                                          u:object_r:proc_stat:s0
/sys/class/kgsl/kgsl-3d0/gpu_busy_percentage        u:object_r:vendor_sysfs_kgsl:s0
/sys/class/kgsl/kgsl-3d0/temp                       u:object_r:vendor_sysfs_kgsl:s0

# LEDs
/sys/devices/platform/soc/994000.i2c/i2c-0/0-003a/leds/led_strips(/.*)?					u:object_r:sysfs_leds:s0

# NFC
/dev/pn553												u:object_r:nfc_device:s0
/vendor/bin/hw/android\.hardware\.nfc_snxxx@1\.2-service						u:object_r:hal_nfc_default_exec:s0

# Sensors
/vendor/bin/hw/android.hardware.sensors@[0-9].[0-9]-service.phone2-multihal                        u:object_r:hal_sensors_default_exec:s0

# Vibrator
/(vendor|system/vendor)/bin/hw/vendor\.qti\.hardware\.vibrator\.service\.nt				u:object_r:hal_vibrator_default_exec:s0

# Powerstats
/vendor/bin/hw/android\.hardware\.power\.stats-service                                             u:object_r:hal_power_stats_default_exec:s0
