typeattribute glyph_app mlstrustedsubject;

app_domain(glyph_app)

allow glyph_app {
  activity_service
  activity_task_service
  app_function_service
  audio_service
  audioserver_service
  autofill_service
  batteryproperties_service
  batterystats_service
  content_capture_service
  game_service
  gpu_service
  hint_service
  media_session_service
  netstats_service
  protolog_configuration_service
  sensitive_content_protection_service
  sensorservice_service
  surfaceflinger_service
  thermal_service
  uimode_service
  vendor_perf_service
  vibrator_manager_service
  voiceinteraction_service
  virtual_device_service
}:service_manager find;

allow glyph_app system_app_data_file:dir create_dir_perms;
allow glyph_app system_app_data_file:{
  file
  lnk_file
} create_file_perms;

allow glyph_app sysfs_leds:dir r_dir_perms;
allow glyph_app sysfs_led_strips:dir r_dir_perms;
allow glyph_app sysfs_led_strips:{
  file
  lnk_file
} rw_file_perms;

dontaudit glyph_app mnt_vendor_file:dir search;
