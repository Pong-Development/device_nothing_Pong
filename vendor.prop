# Audio
persist.vendor.audio_hal.dsp_bit_width_enforce_mode=24
ro.vendor.audio.downmix.attenuation=1
ro.audio.ignore_effects=false

# Biometrics
ro.vendor.fingerprint.type=udfps_optical
ro.vendor.fingerprint.sensor_location=540|2186|93

# Bluetooth
bluetooth.device.default_name=Nothing Phone (2)
bluetooth.hardware.power.idle_cur_ma=6
bluetooth.hardware.power.operating_voltage_mv=3700
bluetooth.hardware.power.rx_cur_ma=28
bluetooth.hardware.power.tx_cur_ma=36
persist.sys.fflag.override.settings_bluetooth_hearing_aid=true
persist.vendor.btstack.aac_frm_ctl.enabled=true
persist.vendor.qcom.bluetooth.a2dp_offload_cap=sbc-aptx-aptxtws-aptxhd-aac-ldac-aptxadaptiver2
persist.vendor.qcom.bluetooth.aac_frm_ctl.enabled=true
persist.vendor.qcom.bluetooth.aac_vbr_ctl.enabled=true
persist.vendor.qcom.bluetooth.aptxadaptiver2_1_support=true
ro.vendor.bluetooth.csip_qti=true

# Camera
ro.camera.enableCamera1MaxZsl=1
vendor.camera.aux.packageexcludelist=org.telegram.messenger,org.thunderdog.challegram,us.zoom.videomeetings

# Display
ro.surface_flinger.use_content_detection_for_refresh_rate=true
ro.surface_flinger.set_display_power_timer_ms=1000
ro.surface_flinger.set_idle_timer_ms=80
ro.surface_flinger.set_touch_timer_ms=200
vendor.display.disable_noise_layer=1
vendor.display.disable_spec_fence=1
vendor.display.disable_system_load_check=1
vendor.display.enable_async_powermode=0
vendor.display.vds_allow_hwc=1
vendor.display.use_layer_ext=1

# DPM
persist.vendor.dpm.vndr.feature=11
persist.vendor.dpm.vndr.halservice.enable=1
persist.vendor.dpm.vndr.idletimer.mode=default
persist.vendor.dpm.vndr.tcm=2

# DRM
drm.service.enabled=true

# FRP
ro.frp.pst=/dev/block/bootdevice/by-name/frp

# Gatekeeper
vendor.gatekeeper.disable_spu=true

# Incremental FS
ro.incremental.enable=yes

# Keystore
ro.hardware.keystore_desede=true

# Media
debug.stagefright.c2inputsurface=-1
vendor.media.omx=0

# Netflix
ro.netflix.bsp_rev=Q8450-34634-1

# NTF
ro.vendor.nothing.feature.base=0x600800001004458438124a040106b4247b97ffL
ro.vendor.nothing.feature.diff.device.Pong=0x24000003044002001aa4144ac04803d1842000L

# Sensors
persist.vendor.sensors.enable.mag_filter=true
